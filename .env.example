# Copy to .env for local development. On Render, set these under Environment.

# Required: your Neon connection string (Neon dashboard → Connect → copy the connection string)
DATABASE_URL=

# Required for scheduled runs: any long random string (32+ characters). Use the same value as the
# CRON_SECRET repository secret in GitHub.
CRON_SECRET=

# The app's public address, used in email links. Render sets RENDER_EXTERNAL_URL automatically,
# so this is only needed for a custom domain or local development.
APP_URL=http://localhost:3000

# AI tailoring (free tier). Without it, CVs use your own wording, reordered by relevance.
GEMINI_API_KEY=
# Optional: pick a model; falls back to gemini-3.8-flash, then gemini-3.5-flash-lite.
GEMINI_MODEL=

# Sign in with Google (optional). Create an OAuth client (Web application) in Google Cloud Console
# with redirect URI https://<your-app>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional but recommended). A Gmail app password works and is free. Use a separate
# Gmail account just for sending, not your main one: Google Account → Security → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Test only. Never set in production.
# E2E_HOOKS=1
